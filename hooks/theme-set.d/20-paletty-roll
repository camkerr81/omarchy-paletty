#!/bin/bash
# Omarchy Hook: Pre-stage the next random Paletty roll whenever paletty-roll is activated
THEME_NAME="$1"

if [[ "$THEME_NAME" == "paletty-roll" ]]; then
  # Prepare next roll in background so the theme chooser is immediately primed for next time
  nohup "${HOME}/.local/bin/omarchy-paletty-roll" --prepare-next >/dev/null 2>&1 &
fi
